# Copy to .env for local dev. Never commit real values.

# --- LLM provider ---
# Free default for local demos/tests. Options: mock, gemini, openai, ollama.
LLM_PROVIDER=mock

# Gemini Developer API, hosted option with a free tier.
# Get a key from Google AI Studio and set LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI, only needed when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama, only needed when LLM_PROVIDER=ollama.
# Start Ollama locally, then pick a model you have pulled.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- Pinterest OAuth ---
# Register your app at https://developers.pinterest.com/apps/
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Metrics ---
METRICS_DB=grandassist_metrics.db
